# Production build default: persist saves to PocketBase.
#
# `vite build` inlines this into the bundle, so it is baked into the deployed
# files and cannot be changed afterwards. Note that 127.0.0.1 resolves in the
# *player's* browser, not on the server: keep this only if the game is served
# from the same machine as its save server. For a normal static host, override
# it with the public URL of your PocketBase instance at build time, e.g.
#
#   VITE_PB_URL=https://pb.example.com npm run build
#
# or unset it entirely to fall back to per-browser localStorage saves.
VITE_PB_URL=http://127.0.0.1:8090
