# Persistence backend. Set VITE_PB_URL to use PocketBase as the save store.
# Leave it unset to keep the previous localStorage-only behaviour.
# Vite only exposes VITE_* vars; set this at dev/build time.
VITE_PB_URL=http://127.0.0.1:8090

# PocketBase admin credentials used by `npm run pb:setup`.
PB_SUPERUSER_EMAIL=admin@sorstar.local
PB_SUPERUSER_PASSWORD=sorstar-admin-dev

# Optional: bind address for `npm run pb:serve`.
PB_HTTP=127.0.0.1:8090